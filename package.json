{
  "name": "hipkop-player",
  "version": "0.3.0",
  "private": true,
  "description": "HIPKOP PLAYER — Rap + K-POP 竖屏音乐体验（SQLite 目录 + 元数据 Provider）",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env server.js",
    "sync": "node --env-file-if-exists=.env scripts/sync-once.js",
    "check": "node --check server.js && node --check public/app.js",
    "test": "node --test",
    "agent:taxonomy": "node --env-file-if-exists=.env scripts/taxonomy-agent.js"
  },
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {}
}
