# Copy to .env and fill in. The npm scripts load it with --env-file-if-exists,
# so no flag is needed. Everything here is optional.
#
# Turn the taxonomy agent model backend on with a DeepSeek key.
# Without any key the agent stays on the deterministic offline heuristic.
DEEPSEEK_API_KEY=
#HIPKOP_AGENT_MODEL=deepseek-chat
#HIPKOP_AGENT_URL=https://api.deepseek.com/chat/completions
#HIPKOP_AGENT_MIN_CONFIDENCE=0.7
#HIPKOP_AGENT_BATCH=50
#HIPKOP_AGENT_TIMEOUT_MS=30000
#HIPKOP_AGENT_JSON_MODE=1

# Server
#HIPKOP_PLAYER_PORT=4180
#HIPKOP_CHART_STOREFRONTS=us,kr,jp
#LASTFM_API_KEY=

# Production (keep secrets out of Git)
#NODE_ENV=production
#PORT=8080
#HIPKOP_PLAYER_HOST=0.0.0.0
#HIPKOP_PUBLIC_ORIGIN=https://YOUR_DOMAIN
#HIPKOP_ADMIN_TOKEN=GENERATE_A_PRIVATE_RANDOM_TOKEN_AT_LEAST_32_CHARS
#HIPKOP_DB_PATH=/data/hipkop.sqlite
#HIPKOP_MEDIA_DIR=/data/media
# Enable only behind the documented trusted ingress, never on an exposed app port.
#HIPKOP_TRUST_PROXY=true
# Docker Compose also requires HIPKOP_DOMAIN=YOUR_DOMAIN
#HIPKOP_SCHEDULER=1

# Read cache. Empty (the default) uses an in-process LRU, which is plenty for a
# single container. Point it at Redis to share the cache across replicas and to
# keep it warm across a restart; a Redis outage degrades to the in-process LRU,
# never to an error. docker compose already starts one and sets this for you.
#HIPKOP_REDIS_URL=redis://redis:6379
